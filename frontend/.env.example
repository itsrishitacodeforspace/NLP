# --- Backend ---
# Base URL of the FastAPI backend (no trailing slash).
# In the standard deployment this is http://localhost:8000.
# NOTE: localhost and 127.0.0.1 are DIFFERENT origins for CORS — use whichever
# the browser actually navigates to, and mirror it in the backend CORS_ORIGINS.
BACKEND_URL=http://127.0.0.1:8010

# --- Auth (optional) ---
# When the backend has AUTH_ENABLED=true the login form becomes available.
# Tokens are stored in localStorage (documented trade-off, see README §Auth).
AUTH_ENABLED=false

# The token key name in localStorage (never rename casually; old sessions break).
AUTH_STORAGE_KEY=bharatcontract.token
