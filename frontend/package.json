{
  "name": "bharatcontract-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "BharatContract AI — legal contract intelligence frontend (Next.js 14 App Router)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
