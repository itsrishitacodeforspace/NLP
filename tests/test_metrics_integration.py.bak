"""Tests for metrics integration module."""
from __future__ import annotations

from pathlib import Path
import json


class TestMetricsIntegration:
    """Tests for the metrics integration module."""

    def test_gold_annotations_exist(self) -> None:
        """Gold annotations file should exist."""
        gold_path = Path(__file__).parent.parent / "nlp" / "evaluation" / "gold_annotations" / "cases_gold.json"
        assert gold_path.exists(), f"Gold annotations file not found at {gold_path}"

        with open(gold_path) as f:
            data = json.load(f)

        assert "cases" in data
        assert len(data["cases"]) == 17

    def test_load_gold_annotations(self) -> None:
        """Gold annotations should be loadable."""
        from nlp.evaluation.metrics_integration import load_gold_annotations

        annotations = load_gold_annotations()
        assert "cases" in annotations
        assert len(annotations["cases"]) == 17

    def test_extract_entities_from_analysis(self) -> None:
        """Entities should be extractable from analysis results."""
        from app.models.schemas import AnalysisResult, ContractSummary
        from nlp.evaluation.metrics_integration import extract_entities_from_analysis

        result = AnalysisResult(
            contract=ContractSummary(
                contract_id="test",
                title="Test",
                file_name="test.txt",
                parties=["Vendor", "Client"],
            )
        )

        entities = extract_entities_from_analysis(result)
        assert len(entities) == 2
        assert entities[0].text == "Vendor"
        assert entities[1].text == "Client"
        assert entities[0].entity_type == "PARTY"

    def test_compute_case_metrics_basic(self) -> None:
        """Basic metrics should be computable."""
        from nlp.evaluation.metrics_integration import compute_case_metrics, load_gold_annotations

        # Load first case
        gold = load_gold_annotations()
        case_id = list(gold["cases"].keys())[0]

        # We can't test full computation without a real AnalysisResult
        # This test just verifies the function signature
        assert case_id is not None

    def test_run_integrated_evaluation(self) -> None:
        """Integrated evaluation should run without errors."""
        from nlp.evaluation.metrics_integration import run_integrated_evaluation

        report = run_integrated_evaluation()

        assert len(report.case_metrics) == 17
        assert report.aggregate is not None

        # Check that aggregates are computed
        assert "classification" in report.aggregate
        assert "ner" in report.aggregate
        assert "obligations" in report.aggregate
        assert "risks" in report.aggregate
        assert "evidence" in report.aggregate

    def test_generate_integrated_report_json(self) -> None:
        """JSON report should be generatable."""
        from nlp.evaluation.metrics_integration import run_integrated_evaluation, generate_integrated_report_json

        report = run_integrated_evaluation()
        json_output = generate_integrated_report_json(report)

        assert "version" in json_output
        assert "aggregate_metrics" in json_output
        assert "case_results" in json_output
        assert len(json_output["case_results"]) == 17
